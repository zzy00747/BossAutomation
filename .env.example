NODE_ENV=development
DRY_RUN=true

# 浏览器配置
# 注意：Playwright 在 Windows 下可能把 localhost 解析为 ::1（IPv6），
# 而 Chrome 默认监听 127.0.0.1（IPv4），导致 ECONNREFUSED ::1:9222。
# 建议显式使用 127.0.0.1，并在启动 Chrome 时加 --remote-debugging-address=127.0.0.1。
CDP_URL=http://127.0.0.1:9222

# 系统 Chrome 路径，用于 CDP 不可用时自动启动或 fallback。
# Windows 示例：C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS 示例：/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux 示例：/usr/bin/google-chrome
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# LLM 配置（至少填一个 provider 的 key）
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_BASE_URL=

# 业务配置
MATCH_SCORE_THRESHOLD=75
APPLY_DAILY_LIMIT=20
DETAIL_CONCURRENCY=3
LLM_CONCURRENCY=5
APPLY_CONCURRENCY=1

# 岗位意图：自然语言描述，供 LLM JD 筛选使用
# 也可写入 config/job-intent.txt（环境变量优先）
JOB_INTENT=

# 搜索配置（可选）
# 逗号分隔多个关键词，每个关键词生成一个搜索配置
SEARCH_KEYWORDS=
SEARCH_MAX_PAGES=5

# 数据路径
SCREENSHOT_DIR=data/logs/screenshots
DB_PATH=data/jobs.sqlite
