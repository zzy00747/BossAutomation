NODE_ENV=development
DRY_RUN=true

# 浏览器配置
CDP_URL=http://localhost:9222
CHROME_PATH=

# LLM 配置（至少填一个 provider 的 key）
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_BASE_URL=

# 业务配置
MATCH_SCORE_THRESHOLD=75
APPLY_DAILY_LIMIT=20
DETAIL_CONCURRENCY=3
LLM_CONCURRENCY=5
APPLY_CONCURRENCY=1

# 岗位意图：自然语言描述，供 LLM JD 筛选使用
# 也可写入 config/job-intent.txt（环境变量优先）
JOB_INTENT=

# 搜索配置（可选）
# 逗号分隔多个关键词，每个关键词生成一个搜索配置
SEARCH_KEYWORDS=
SEARCH_MAX_PAGES=5

# 数据路径
SCREENSHOT_DIR=data/logs/screenshots
DB_PATH=data/jobs.sqlite
